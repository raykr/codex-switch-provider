#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "Usage:" >&2
  echo "  codex-switch-provider <provider>" >&2
  echo "  codex-switch-provider restore [timestamp]" >&2
  echo "  codex-switch-provider list-backups" >&2
}

restart_app_server() {
  local app_server_control_dir="$codex_home/app-server-control"
  local app_server_log="$app_server_control_dir/app-server.log"

  # Clear stale proxy/listen processes so remote clients reload fresh state.
  pkill -f 'codex app-server proxy' >/dev/null 2>&1 || true
  pkill -f 'codex app-server --listen unix://' >/dev/null 2>&1 || true
  rm -f "$app_server_control_dir/app-server-control.sock"

  umask 077
  mkdir -p "$app_server_control_dir"
  nohup codex app-server --listen unix:// >"$app_server_log" 2>&1 &
  sleep 1
}

if [[ $# -lt 1 ]]; then
  usage
  exit 2
fi

cmd="$1"
codex_home="${CODEX_HOME:-$HOME/.codex}"
config_path="$codex_home/config.toml"
state_db="$codex_home/state_5.sqlite"
backup_root="$codex_home/backups"
config_backup_dir="$backup_root/config"
state_backup_dir="$backup_root/state"
session_backup_dir="$backup_root/session"

if [[ ! -f "$config_path" ]]; then
  echo "config.toml not found: $config_path" >&2
  exit 2
fi
if [[ ! -f "$state_db" ]]; then
  echo "state sqlite not found: $state_db" >&2
  exit 2
fi
if ! command -v sqlite3 >/dev/null 2>&1; then
  echo "sqlite3 not found in PATH" >&2
  exit 2
fi
if ! command -v python3 >/dev/null 2>&1; then
  echo "python3 not found in PATH" >&2
  exit 2
fi

if [[ "$cmd" == "restore" || "$cmd" == "restore-last" || "$cmd" == "--restore-last" ]]; then
  if [[ "$cmd" != "restore" && $# -gt 1 ]]; then
    echo "Timestamp is only supported with 'restore' command." >&2
    usage
    exit 2
  fi
  if [[ "$cmd" == "restore" && $# -gt 2 ]]; then
    usage
    exit 2
  fi

  target_stamp="${2:-}"
  shopt -s nullglob
  config_backups=( "$config_backup_dir"/config.toml.*.bak )
  shopt -u nullglob
  if [[ ${#config_backups[@]} -eq 0 ]]; then
    echo "No config backup found in $config_backup_dir" >&2
    exit 2
  fi

  latest_config_backup=""
  if [[ -n "$target_stamp" ]]; then
    latest_config_backup="$config_backup_dir/config.toml.$target_stamp.bak"
    if [[ ! -f "$latest_config_backup" ]]; then
      echo "Config backup for stamp '$target_stamp' not found: $latest_config_backup" >&2
      exit 2
    fi
    stamp="$target_stamp"
  else
    for f in "${config_backups[@]}"; do
      latest_config_backup="$f"
    done
    backup_name="$(basename "$latest_config_backup")"
    stamp="${backup_name#config.toml.}"
    stamp="${stamp%.bak}"
  fi

  latest_state_backup="$state_backup_dir/state_5.sqlite.$stamp.bak"
  latest_session_backup="$session_backup_dir/$stamp"

  if [[ ! -f "$latest_state_backup" ]]; then
    echo "State backup for stamp '$stamp' not found: $latest_state_backup" >&2
    exit 2
  fi

  restore_stamp="$(date +%Y%m%d-%H%M%S)"
  mkdir -p "$config_backup_dir" "$state_backup_dir" "$session_backup_dir/$restore_stamp.pre_restore"
  cp -a "$config_path" "$config_backup_dir/config.toml.$restore_stamp.pre_restore.bak"
  cp -a "$state_db" "$state_backup_dir/state_5.sqlite.$restore_stamp.pre_restore.bak"
  for suffix in -wal -shm; do
    if [[ -f "$state_db$suffix" ]]; then
      cp -a "$state_db$suffix" "$state_backup_dir/state_5.sqlite.$restore_stamp.pre_restore.bak$suffix"
    fi
  done

  cp -a "$latest_config_backup" "$config_path"
  cp -a "$latest_state_backup" "$state_db"
  for suffix in -wal -shm; do
    if [[ -f "$latest_state_backup$suffix" ]]; then
      cp -a "$latest_state_backup$suffix" "$state_db$suffix"
    else
      rm -f "$state_db$suffix"
    fi
  done

  export CODEX_SWITCH_HOME="$codex_home"
  export CODEX_SWITCH_RESTORE_SNAPSHOT="$latest_session_backup"
  export CODEX_SWITCH_PRE_RESTORE="$session_backup_dir/$restore_stamp.pre_restore"
  python3 - <<'PY'
import shutil
import os
from pathlib import Path

home = Path(os.environ["CODEX_SWITCH_HOME"])
snapshot = Path(os.environ["CODEX_SWITCH_RESTORE_SNAPSHOT"])
pre_restore = Path(os.environ["CODEX_SWITCH_PRE_RESTORE"])
restored = 0

if not snapshot.exists():
    print(f"session_snapshot_missing={snapshot}")
    raise SystemExit(0)

for src in snapshot.rglob("*"):
    if not src.is_file():
        continue
    rel = src.relative_to(snapshot)
    dst = home / rel
    if dst.exists():
        backup_dst = pre_restore / rel
        backup_dst.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(dst, backup_dst)
    dst.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(src, dst)
    restored += 1

print(f"session_files_restored={restored}")
PY

  codex --version
  restart_app_server
  echo "Restored backup stamp '$stamp'."
  echo "Config restored from: $latest_config_backup"
  echo "State restored from: $latest_state_backup"
  echo "Session restored from: $latest_session_backup"
  echo "Pre-restore backup stamp: $restore_stamp.pre_restore"
  echo "App server cache reset: done (unix:// restarted)"
  exit 0
fi

if [[ "$cmd" == "list-backups" || "$cmd" == "--list-backups" ]]; then
  mkdir -p "$config_backup_dir" "$state_backup_dir" "$session_backup_dir"
  shopt -s nullglob
  config_backups=( "$config_backup_dir"/config.toml.*.bak )
  shopt -u nullglob

  if [[ ${#config_backups[@]} -eq 0 ]]; then
    echo "No backups found."
    exit 0
  fi

  total=0
  echo "Available backup snapshots (newest last):"
  for f in "${config_backups[@]}"; do
    name="$(basename "$f")"
    stamp="${name#config.toml.}"
    stamp="${stamp%.bak}"

    has_state="no"
    has_session="no"
    [[ -f "$state_backup_dir/state_5.sqlite.$stamp.bak" ]] && has_state="yes"
    [[ -d "$session_backup_dir/$stamp" ]] && has_session="yes"

    printf -- "- %s | config: yes | state: %s | session: %s\n" "$stamp" "$has_state" "$has_session"
    total=$((total + 1))
  done
  echo "Total snapshots: $total"
  exit 0
fi

provider="$cmd"
if [[ "$provider" != "openai" ]]; then
  if ! rg -n "^\[model_providers\.${provider//./\\.}\]$" "$config_path" >/dev/null; then
    echo "Warning: provider '$provider' not found under [model_providers.*] in $config_path" >&2
  fi
fi

backup="$config_path.bak.$(date +%Y%m%d-%H%M%S)"
stamp="$(date +%Y%m%d-%H%M%S)"
mkdir -p "$config_backup_dir" "$state_backup_dir" "$session_backup_dir"
backup="$config_backup_dir/config.toml.$stamp.bak"
cp -a "$config_path" "$backup"

tmp="$(mktemp)"
awk -v target="$provider" '
BEGIN { in_root=1; replaced=0; inserted=0 }
{
  line=$0
  if (line ~ /^\s*\[/) {
    if (in_root && !replaced && !inserted) {
      print "model_provider = \"" target "\""
      inserted=1
    }
    in_root=0
    print line
    next
  }
  if (in_root && line ~ /^[[:space:]]*model_provider[[:space:]]*=/) {
    if (!replaced) {
      print "model_provider = \"" target "\""
      replaced=1
    }
    next
  }
  print line
}
END {
  if (in_root && !replaced && !inserted) {
    print "model_provider = \"" target "\""
  }
}
' "$config_path" > "$tmp"
mv "$tmp" "$config_path"

# Sync state_5.sqlite provider bucket.
cp -a "$state_db" "$state_backup_dir/state_5.sqlite.$stamp.bak"
for suffix in -wal -shm; do
  if [[ -f "$state_db$suffix" ]]; then
    cp -a "$state_db$suffix" "$state_backup_dir/state_5.sqlite.$stamp.bak$suffix"
  fi
done

provider_q="$(printf "%s" "$provider" | sed "s/'/''/g")"
rows_to_update="$(
  sqlite3 "$state_db" \
  "SELECT COUNT(*) FROM threads WHERE model_provider != '$provider_q';"
)"
if [[ "$rows_to_update" != "0" ]]; then
  sqlite3 "$state_db" <<EOF
BEGIN IMMEDIATE;
UPDATE threads SET model_provider = '$provider_q' WHERE model_provider != '$provider_q';
COMMIT;
EOF
fi

# Sync rollout jsonl session_meta provider.
export CODEX_SWITCH_PROVIDER="$provider"
export CODEX_SWITCH_HOME="$codex_home"
export CODEX_SWITCH_BACKUP="$session_backup_dir/$stamp"
python3 - <<'PY'
import json
import os
import shutil
from pathlib import Path

provider = os.environ["CODEX_SWITCH_PROVIDER"]
home = Path(os.environ["CODEX_SWITCH_HOME"])
backup_root = Path(os.environ["CODEX_SWITCH_BACKUP"])
backup_root.mkdir(parents=True, exist_ok=True)

roots = [home / "sessions", home / "archived_sessions"]
changed = 0
total = 0
for root in roots:
    if not root.exists():
        continue
    for path in root.rglob("*.jsonl"):
        total += 1
        lines = path.read_text(encoding="utf-8").splitlines()
        out = []
        file_changed = False
        for line in lines:
            if not line.strip():
                out.append(line)
                continue
            try:
                obj = json.loads(line)
            except json.JSONDecodeError:
                out.append(line)
                continue
            if obj.get("type") == "session_meta" and isinstance(obj.get("payload"), dict):
                old = obj["payload"].get("model_provider")
                if old != provider:
                    obj["payload"]["model_provider"] = provider
                    file_changed = True
                line = json.dumps(obj, ensure_ascii=False, separators=(",", ":"))
            out.append(line)
        if file_changed:
            rel = path.relative_to(home)
            dst = backup_root / rel
            dst.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(path, dst)
            path.write_text("\n".join(out) + "\n", encoding="utf-8")
            changed += 1
print(f"session_files_total={total}")
print(f"session_files_changed={changed}")
PY

codex --version
restart_app_server

echo "Switched provider to '$provider'."
echo "Config backup: $backup"
echo "State backup: $state_backup_dir/state_5.sqlite.$stamp.bak"
echo "Session backup dir: $session_backup_dir/$stamp"
echo "App server cache reset: done (unix:// restarted)"
